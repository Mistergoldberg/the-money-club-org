---
import BaseLayout from "../layouts/BaseLayout.astro";

const details = [
  ["Dates", "August 10–14"],
  ["Daily schedule", "9:00 AM–5:00 PM"],
  ["Instruction begins", "9:30 AM"],
  ["Lunch", "12:00–1:00 PM"],
  ["Pick-up window", "3:30–5:00 PM"],
  ["Location", "UTSU Student Commons"],
  ["Address", "230 College Street, Toronto"],
  ["Tuition", "$200"],
  ["Program size", "Limited to 30 students"],
] as const;

const cards = [
  {
    title: "Money",
    copy: "Students learn cost, price, margin, risk, and trade-offs.",
    image: "/images/index-version-2/kid-presents-large-class.jpg",
    alt: "A student presenting work to a large class.",
  },
  {
    title: "Business",
    copy: "Students explore how products, customers, and markets connect.",
    image: "/images/index-version-2/student-ux.jpg",
    alt: "Students reviewing product and design ideas together.",
  },
  {
    title: "AI",
    copy: "Students use AI tools to research, write, design, and test ideas.",
    image: "/images/index-version-2/apps.jpg",
    alt: "A student presenting app and project ideas.",
  },
  {
    title: "Communication",
    copy: "Students learn to explain their thinking clearly.",
    image: "/images/home/student-presenting-work.jpg",
    alt: "A student presenting a project to classmates.",
  },
  {
    title: "Judgment",
    copy: "Students practice making decisions with incomplete information.",
    image: "/images/home/students-testing-ideas.jpg",
    alt: "Students testing ideas and reviewing evidence together.",
  },
  {
    title: "Confidence",
    copy: "Students leave with something they built and can explain.",
    image: "/images/home/students-building-products.jpg",
    alt: "Students building and labelling sample products together.",
  },
] as const;
---

<BaseLayout
  title="Index Version 2"
  description="A review-only homepage variant following the supplied homepage funnel brief and the media-led original site format."
  canonicalPath="/index-version-2/"
  noIndex
>
  <div class="index-v2" aria-labelledby="index-v2-title">
    <section class="index-v2-hero">
      <div class="index-v2-wrap">
        <div class="brand-lockup" aria-label="The Money Club.Org">
          <img
            src="/images/index-version-2/logo-500.png"
            alt=""
            width="500"
            height="500"
            loading="eager"
          />
          <p>The Money Club<span>.Org</span></p>
        </div>

        <div class="hero-copy">
          <p class="hero-kicker">Financial literacy for young builders</p>
          <h1 id="index-v2-title">
            Kids don’t need more money slogans. They need to see how money moves.
          </h1>
          <p>
            The Money Club is a hands-on financial literacy and entrepreneurship
            program for students who are ready to build, test, price, explain,
            and present real ideas.
          </p>
          <p>
            This August, we are running a one-week program at the UTSU Student
            Commons in downtown Toronto.
          </p>

          <div class="hero-actions" aria-label="Homepage calls to action">
            <a class="index-v2-button index-v2-button--teal" href="/parent-approval/">
              Register for August
            </a>
            <a class="index-v2-button index-v2-button--purple" href="/curriculum/">
              See the Curriculum
            </a>
          </div>

          <p class="trust-line">
            August 10–14 · 9:00 AM–5:00 PM · UTSU Student Commons · 230 College
            Street · $200 · Limited to 30 students
          </p>
        </div>

        <figure class="hero-media">
          <img
            src="/images/index-version-2/kids-index.jpg"
            alt="Students working together in a bright classroom setting."
            width="1920"
            height="877"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      </div>
    </section>

    <section class="index-v2-section" id="problem" aria-labelledby="problem-title-v2">
      <div class="section-banner section-banner--teal">
        <div class="index-v2-wrap">
          <h2 id="problem-title-v2">Most financial literacy starts too late and stays too abstract.</h2>
        </div>
      </div>
      <div class="section-content index-v2-wrap split">
        <div class="section-copy">
          <p>Students are told to save money, budget carefully, and make good choices.</p>
          <p>That is useful.</p>
          <p>But it is not enough.</p>
          <p>
            They also need to understand pricing, cost, margin, risk, incentives,
            labour, technology, ownership, and trade-offs.
          </p>
          <p>
            They need to learn why a lemonade stand is simple, but a coffee shop
            becomes a system.
          </p>
          <p>
            They need to see that money is not just something people earn and spend.
          </p>
          <p class="statement-card">
            Money is a language. A signal. A tool. A system of choices with
            consequences.
          </p>
          <p>The Money Club helps students learn that system early.</p>
        </div>
        <figure class="section-image">
          <img
            src="/images/home/prototype-in-hand.jpg"
            alt="Students holding a cardboard phone prototype to make an idea concrete."
            width="1720"
            height="1920"
            loading="lazy"
          />
        </figure>
      </div>
    </section>

    <section class="index-v2-section" id="student-work" aria-labelledby="student-work-title-v2">
      <div class="section-banner section-banner--purple">
        <div class="index-v2-wrap">
          <h2 id="student-work-title-v2">Students learn by building.</h2>
        </div>
      </div>
      <div class="section-content index-v2-wrap">
        <div class="section-copy section-copy--wide">
          <p>Over the week, students move from ideas to real-world thinking.</p>
          <p>
            They investigate how businesses work. They use AI as a thinking
            partner. They explore customers, costs, pricing, and value. They
            build projects.
          </p>
          <p>They explain their thinking. They present what they made.</p>
          <p>This is not worksheet learning.</p>
          <p>
            It is project-based financial literacy for the world students are
            actually entering.
          </p>
        </div>

        <div class="supporting-cards" aria-label="Supporting cards">
          {cards.map((card) => (
            <article class="supporting-card">
              <figure>
                <img src={card.image} alt={card.alt} loading="lazy" />
              </figure>
              <div>
                <h3>{card.title}</h3>
                <p>{card.copy}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="index-v2-section" id="program-details-v2" aria-labelledby="program-title-v2">
      <div class="section-banner section-banner--gold">
        <div class="index-v2-wrap">
          <h2 id="program-title-v2">August 10–14, Toronto</h2>
        </div>
      </div>
      <div class="section-content index-v2-wrap split split--reverse">
        <figure class="section-image media-with-cta">
          <img
            src="/images/index-version-2/kids-campus.jpg"
            alt="Students walking together outside a downtown campus building."
            width="1536"
            height="1024"
            loading="lazy"
          />
          <a class="index-v2-button index-v2-button--teal" href="/parent-approval/">
            Complete Parent Approval
          </a>
        </figure>

        <dl class="details-grid" aria-label="Program details">
          {details.map(([label, value]) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="index-v2-section" id="who-its-for-v2" aria-labelledby="who-title-v2">
      <div class="section-banner section-banner--teal">
        <div class="index-v2-wrap">
          <h2 id="who-title-v2">Built for curious students ages 10–16.</h2>
        </div>
      </div>
      <div class="section-content index-v2-wrap split">
        <div class="section-copy">
          <p>
            The program is designed for students who are ready to work
            independently on a laptop, participate in group discussion, and
            build creative projects.
          </p>
          <p>
            Most interest so far has come from families with students around
            ages 13–15, but the best fit is not only age.
          </p>
          <p>The best fit is readiness.</p>
          <p>
            If your child is curious, creative, entrepreneurial, analytical, or
            simply ready to understand the world more clearly, this program was
            built for them.
          </p>
        </div>
        <figure class="section-image">
          <img
            src="/images/index-version-2/student-ux.jpg"
            alt="A student discussing ideas with adults during a project conversation."
            width="1720"
            height="1920"
            loading="lazy"
          />
        </figure>
      </div>
    </section>

    <section class="index-v2-section" id="parent-trust-v2" aria-labelledby="trust-title-v2">
      <div class="section-banner section-banner--purple">
        <div class="index-v2-wrap">
          <h2 id="trust-title-v2">Confirmed, insured, and ready to run.</h2>
        </div>
      </div>
      <div class="section-content index-v2-wrap split split--reverse">
        <figure class="section-image">
          <img
            src="/images/home/mentor-working-with-students.jpg"
            alt="A mentor working with a small group of students around laptops and a whiteboard."
            width="1536"
            height="1024"
            loading="lazy"
          />
        </figure>
        <div class="section-copy">
          <p>
            After speaking with parents and confirming demand, The Money Club
            has reached the minimum threshold to run the August session.
          </p>
          <p>
            The venue is confirmed. The program is insured. The curriculum is
            built. The cohort is intentionally limited.
          </p>
          <p>
            This first session is designed to be small, focused, and high-touch.
          </p>
          <p class="statement-card">
            Limited to 30 students so the experience stays personal, active,
            and well-supported.
          </p>
        </div>
      </div>
    </section>

    <section class="index-v2-section" id="bigger-mission-v2" aria-labelledby="mission-title-v2">
      <div class="section-banner section-banner--teal">
        <div class="index-v2-wrap">
          <h2 id="mission-title-v2">The Money Club is also building a student employment engine.</h2>
        </div>
      </div>
      <div class="section-content index-v2-wrap split">
        <div class="section-copy">
          <p>The long-term goal is not only to teach younger students.</p>
          <p>
            The goal is to create meaningful mentorship and employment
            opportunities for UofT students.
          </p>
          <p>
            As The Money Club grows, university students will be trained to
            support programs, become paid mentors, and eventually help launch
            new Money Club chapters.
          </p>
          <p>
            Students teach students. Mentors become leaders. Chapters create
            opportunity.
          </p>
          <p>That is the flywheel.</p>
          <a class="index-v2-button index-v2-button--purple" href="/mentor-fellowship/">
            Learn About the Mentor Fellowship
          </a>
        </div>
        <figure class="section-image">
          <img
            src="/images/index-version-2/flywheel.jpg"
            alt="A circular flywheel illustration representing students, mentors, and chapters."
            width="900"
            height="900"
            loading="lazy"
          />
        </figure>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .index-v2 {
    --old-teal: #1e8a95;
    --old-purple: #8c62a7;
    --old-gold: #f0b43a;
    --old-line: #e5e1da;
    --old-ink: #111111;
    --old-muted: #3d3d3d;
    --old-pad: clamp(18px, 3.5vw, 34px);
    --old-max: 82.5rem;
    color: var(--old-ink);
    background: #ffffff;
  }

  .index-v2-wrap {
    width: min(100% - (2 * var(--old-pad)), var(--old-max));
    margin-inline: auto;
  }

  .index-v2-hero {
    padding-block: clamp(18px, 4vw, 46px) var(--space-5);
    background: #ffffff;
  }

  .brand-lockup {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(14px, 2.4vw, 28px);
    margin-inline: auto;
    text-align: left;
  }

  .brand-lockup img {
    width: clamp(4.25rem, 8vw, 7.25rem);
    height: clamp(4.25rem, 8vw, 7.25rem);
  }

  .brand-lockup p {
    color: var(--old-teal);
    font-family: var(--font-display);
    font-size: clamp(4.25rem, 9vw, 8rem);
    letter-spacing: var(--tracking-display);
    line-height: 0.85;
    text-transform: uppercase;
  }

  .brand-lockup span {
    font-size: 0.38em;
  }

  .hero-copy {
    display: grid;
    gap: var(--space-3);
    max-width: 66rem;
    margin: clamp(var(--space-4), 4vw, var(--space-5)) auto 0;
    text-align: center;
  }

  .hero-kicker {
    color: var(--old-purple);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero-copy h1 {
    max-width: 14ch;
    margin-inline: auto;
    color: var(--old-ink);
    font-size: clamp(4rem, 9vw, 7.5rem);
    line-height: 0.88;
  }

  .hero-copy p:not(.hero-kicker, .trust-line) {
    max-width: 58rem;
    margin-inline: auto;
    color: var(--old-muted);
    font-size: clamp(1.25rem, 1.2rem + 0.8vw, 1.8rem);
    font-weight: 500;
    line-height: 1.35;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .index-v2-button {
    display: inline-flex;
    min-height: 3.75rem;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    padding: 1rem 1.4rem;
    color: #ffffff;
    font-weight: var(--font-weight-bold);
    line-height: var(--line-title);
    text-align: center;
    text-decoration: none;
    box-shadow: 0 10px 20px rgb(17 17 17 / 14%);
  }

  .index-v2-button--teal {
    background: var(--old-teal);
  }

  .index-v2-button--purple {
    background: var(--old-purple);
  }

  .trust-line {
    max-width: 62rem;
    margin-inline: auto;
    color: var(--old-ink);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-copy);
  }

  .hero-media {
    margin: var(--space-4) auto 0;
    overflow: hidden;
    border: 1px solid var(--old-line);
    border-radius: var(--radius-lg);
  }

  .hero-media img {
    width: 100%;
    height: clamp(14rem, 32vw, 26rem);
    object-fit: cover;
    object-position: center 36%;
  }

  .index-v2-section {
    margin-top: var(--space-6);
  }

  .section-banner {
    padding-block: clamp(1.25rem, 3vw, 2rem);
    border-block: 1px solid var(--old-line);
    color: #ffffff;
  }

  .section-banner--teal {
    background: var(--old-teal);
  }

  .section-banner--purple {
    background: var(--old-purple);
  }

  .section-banner--gold {
    background: var(--old-gold);
  }

  .section-banner h2 {
    color: inherit;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 0.86;
  }

  .section-content {
    padding-block: clamp(var(--space-4), 4vw, var(--space-6)) var(--space-4);
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1.06fr) minmax(18rem, 0.94fr);
    gap: clamp(var(--space-4), 4vw, var(--space-6));
    align-items: start;
  }

  .split--reverse {
    grid-template-columns: minmax(18rem, 0.94fr) minmax(0, 1.06fr);
  }

  .section-copy {
    display: grid;
    gap: var(--space-3);
    max-width: 72ch;
    color: var(--old-muted);
    font-size: clamp(1.25rem, 1.1rem + 0.45vw, 1.5rem);
    line-height: 1.42;
  }

  .section-copy--wide {
    max-width: 78ch;
  }

  .statement-card {
    padding: var(--space-4);
    border: 1px solid var(--old-line);
    border-left: 0.45rem solid var(--old-gold);
    border-radius: var(--radius-md);
    background: #ffffff;
    box-shadow: 0 12px 24px rgb(17 17 17 / 8%);
    color: var(--old-ink);
    font-weight: var(--font-weight-bold);
  }

  .section-image {
    display: grid;
    gap: var(--space-3);
    overflow: hidden;
    border: 1px solid var(--old-line);
    border-radius: var(--radius-lg);
    background: #ffffff;
    box-shadow: 0 14px 28px rgb(17 17 17 / 8%);
  }

  .section-image img {
    width: 100%;
    height: 100%;
    max-height: 34rem;
    object-fit: cover;
  }

  .media-with-cta {
    overflow: visible;
    border: 0;
    box-shadow: none;
  }

  .media-with-cta img {
    overflow: hidden;
    border: 1px solid var(--old-line);
    border-radius: var(--radius-lg);
    box-shadow: 0 14px 28px rgb(17 17 17 / 8%);
  }

  .media-with-cta .index-v2-button {
    width: 100%;
  }

  .supporting-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .supporting-card {
    overflow: hidden;
    border: 1px solid var(--old-line);
    border-radius: var(--radius-lg);
    background: #efefef;
    box-shadow: 0 12px 24px rgb(17 17 17 / 8%);
  }

  .supporting-card figure {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .supporting-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .supporting-card div {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3);
  }

  .supporting-card h3 {
    color: var(--old-ink);
    font-family: var(--font-body);
    font-size: clamp(1.4rem, 1.1rem + 1vw, 2rem);
    line-height: var(--line-title);
  }

  .supporting-card p {
    color: var(--old-muted);
    font-size: var(--text-body);
    line-height: var(--line-copy);
  }

  .details-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
    margin: 0;
  }

  .details-grid div {
    display: grid;
    gap: var(--space-1);
    min-height: 6rem;
    padding: var(--space-3);
    border: 1px solid var(--old-line);
    border-radius: var(--radius-md);
    background: #ffffff;
    box-shadow: 0 10px 20px rgb(17 17 17 / 6%);
  }

  .details-grid div:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  .details-grid dt {
    color: var(--old-teal);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .details-grid dd {
    align-self: end;
    margin: 0;
    color: var(--old-ink);
    font-size: var(--text-lg);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-title);
  }

  @media (max-width: 60rem) {
    .split,
    .split--reverse {
      grid-template-columns: 1fr;
    }

    .supporting-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 40rem) {
    .brand-lockup {
      align-items: flex-start;
    }

    .brand-lockup p {
      font-size: clamp(3.1rem, 17vw, 4.8rem);
    }

    .hero-copy {
      text-align: left;
    }

    .hero-copy h1,
    .hero-copy p:not(.hero-kicker, .trust-line),
    .trust-line {
      margin-inline: 0;
    }

    .hero-actions,
    .index-v2-button {
      width: 100%;
    }

    .supporting-cards,
    .details-grid {
      grid-template-columns: 1fr;
    }

    .section-banner h2 {
      font-size: clamp(2.4rem, 14vw, 3.6rem);
    }
  }
</style>
