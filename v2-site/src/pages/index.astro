---
import CtaBlock from "../components/sections/CtaBlock.astro";
import FaqSection from "../components/sections/FaqSection.astro";
import FeatureGrid from "../components/sections/FeatureGrid.astro";
import FinalCtaSection from "../components/sections/FinalCtaSection.astro";
import FounderNote from "../components/sections/FounderNote.astro";
import BuildCycle from "../components/sections/BuildCycle.astro";
import PageHero from "../components/sections/PageHero.astro";
import ProgramDetailsBar from "../components/sections/ProgramDetailsBar.astro";
import ProgramDetailsGrid from "../components/sections/ProgramDetailsGrid.astro";
import SectionIntro from "../components/sections/SectionIntro.astro";
import StickyCta from "../components/sections/StickyCta.astro";
import SystemMap from "../components/sections/SystemMap.astro";
import Section from "../components/ui/Section.astro";
import Button from "../components/ui/Button.astro";
import { homepageContent as content } from "../data/homepage";
import { homepageMedia } from "../data/media";
import HeroMedia from "../components/media/HeroMedia.astro";
import LocationMedia from "../components/media/LocationMedia.astro";
import MediaGrid from "../components/media/MediaGrid.astro";
import ContentPanel from "../components/layout/ContentPanel.astro";
import SectionGrid from "../components/layout/SectionGrid.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Financial Literacy and Entrepreneurship for Young Builders"
  description="A hands-on one-week program where students learn how money moves by building, pricing, testing, explaining, and presenting real ideas."
  canonicalPath="/"
>
  <PageHero
    eyebrow={content.hero.eyebrow}
    headline={content.hero.headline}
    body={content.hero.body}
    primaryLabel={content.hero.primaryCta.label}
    primaryHref={content.hero.primaryCta.href}
    secondaryLabel={content.hero.secondaryCta.label}
    secondaryHref={content.hero.secondaryCta.href}
    proofPoints={content.hero.proofPoints}
    visualOnMobile
  >
    <HeroMedia
      slot="visual"
      media={homepageMedia.hero}
      eyebrow="A hands-on build loop"
      steps={["Build", "Price", "Test", "Explain"]}
    />
  </PageHero>

  <ProgramDetailsBar items={content.trustItems} label={content.trustLine} />

  <Section id="problem" spacing="default" ariaLabelledby="problem-title">
    <SectionGrid media={homepageMedia.problem}>
      <div slot="heading" class="flow">
        <p class="section-kicker">{content.problem.eyebrow}</p>
        <h2 id="problem-title">{content.problem.title}</h2>
      </div>
      <div class="prose">
        {content.problem.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <ContentPanel slot="panel" tone="accent">
          <p class="statement">{content.problem.statement}</p>
      </ContentPanel>
    </SectionGrid>
  </Section>

  <Section
    id="student-work"
    tone="subtle"
    spacing="spacious"
    ariaLabelledby="student-work-title"
  >
    <SectionGrid layout="stack" panelFull>
      <div slot="heading">
        <SectionIntro
          eyebrow={content.studentWork.eyebrow}
          title={content.studentWork.title}
          headingId="student-work-title"
        />
      </div>
      <MediaGrid slot="media" items={homepageMedia.studentWork} />
      <div class="section-lead-stack">
        <p>{content.studentWork.lead}</p>
        <p>{content.studentWork.intro}</p>
      </div>
      <FeatureGrid slot="panel" items={content.outcomes} />
    </SectionGrid>
  </Section>

  <Section
    id="why-it-matters"
    spacing="spacious"
    ariaLabelledby="why-it-matters-title"
  >
    <SectionGrid mediaSide="start">
      <div slot="heading" class="flow">
        <p class="section-kicker">{content.whyItMatters.eyebrow}</p>
        <h2 id="why-it-matters-title">{content.whyItMatters.title}</h2>
      </div>
      <div class="prose">
        {content.whyItMatters.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <SystemMap
        slot="media"
        caption="Every choice affects the system around it."
      />
    </SectionGrid>
  </Section>

  <Section
    id="program-details"
    tone="subtle"
    spacing="spacious"
    ariaLabelledby="program-details-title"
  >
    <SectionGrid panelFull>
      <div slot="heading" class="flow">
        <p class="section-kicker">Program details</p>
        <h2 id="program-details-title">August 10–14, Toronto</h2>
      </div>
      <LocationMedia
        slot="media"
        media={homepageMedia.location}
        venue="UTSU Student Commons"
        address="230 College Street, Toronto"
        showLocationDetails={false}
        showCaption={false}
      />
      <div class="flow">
        <p class="media-section-lead">
          One focused week of workshops, project work, discussion, and
          presentation at the UTSU Student Commons.
        </p>
        <Button href="/parent-approval/" size="large">Register for August</Button>
      </div>
      <ProgramDetailsGrid slot="panel" items={content.programDetails} />
    </SectionGrid>
  </Section>

  <Section id="who-its-for" spacing="spacious" ariaLabelledby="fit-title">
    <SectionGrid media={homepageMedia.fit} mediaSide="start">
      <div slot="heading" class="flow">
        <p class="section-kicker">Who it’s for</p>
        <h2 id="fit-title">Built for curious students ages 10–16.</h2>
      </div>
      <p class="media-section-lead">
        The program is designed for students who can work independently on a
        laptop, contribute to group discussion, and take part in creative
        projects.
      </p>
    </SectionGrid>
  </Section>

  <Section
    id="parent-trust"
    tone="subtle"
    spacing="spacious"
    ariaLabelledby="parent-trust-title"
  >
    <SectionGrid media={homepageMedia.parentTrust}>
      <div slot="heading" class="flow">
        <p class="section-kicker">Parent trust</p>
        <h2 id="parent-trust-title">Confirmed, insured, and ready to run.</h2>
      </div>
      <div class="prose">
        <p>
          After speaking with parents and confirming demand, the minimum
          threshold for the August program has been reached.
        </p>
        <p>
          The venue is confirmed, the program is fully insured, the curriculum
          is built, and the cohort is intentionally limited.
        </p>
        <p>
          The group is capped at 30 students so the experience can stay
          personal, active, focused, and well supported.
        </p>
      </div>
    </SectionGrid>
  </Section>

  <Section
    id="curriculum"
    spacing="spacious"
    ariaLabelledby="curriculum-title"
  >
    <SectionGrid media={homepageMedia.curriculum} panelFull>
      <div slot="heading" class="flow">
        <p class="section-kicker">{content.curriculum.eyebrow}</p>
        <h2 id="curriculum-title">{content.curriculum.title}</h2>
      </div>
      <div class="flow">
        <p class="media-section-lead">{content.curriculum.lead}</p>
        <Button href="/curriculum/" variant="outline" size="large">
          See the Curriculum
        </Button>
      </div>
      <BuildCycle slot="panel" steps={content.buildSteps} />
    </SectionGrid>
  </Section>

  <Section
    id="founder-note"
    tone="subtle"
    spacing="spacious"
    ariaLabelledby="founder-note-heading"
  >
    <FounderNote
      title={content.founderNote.title}
      paragraphs={content.founderNote.paragraphs}
      signature={content.founderNote.signature}
      role={content.founderNote.role}
      headingId="founder-note-heading"
      initials="JG"
      media={homepageMedia.founder}
    />
  </Section>

  <Section
    id="mentor-fellowship"
    spacing="spacious"
    ariaLabelledby="mentor-heading"
  >
    <CtaBlock
      eyebrow={content.mentor.eyebrow}
      title={content.mentor.title}
      primaryLabel="Learn About the Mentor Fellowship"
      primaryHref="/mentor-fellowship/"
      secondaryLabel="See the Chapter Vision"
      secondaryHref="/chapter-vision/"
      tone="primary"
      headingId="mentor-heading"
      media={homepageMedia.mentor}
    >
      <div slot="copy" class="flow">
        <p>{content.mentor.body}</p>
        <p><strong>{content.mentor.statement}</strong></p>
      </div>
    </CtaBlock>
  </Section>

  <FaqSection
    id="faq"
    eyebrow="Questions from families"
    title="Frequently asked questions"
    lead="The practical details parents usually want before completing approval."
    items={content.faqs}
    headingId="faq-title"
  />

  <FinalCtaSection
    id="register"
    eyebrow={content.finalCta.eyebrow}
    title={content.finalCta.title}
    primaryLabel="Register for August"
    primaryHref="/parent-approval/"
    secondaryLabel="See the Curriculum"
    secondaryHref="/curriculum/"
    headingId="final-cta-title"
  >
    <Fragment slot="copy">
      {content.finalCta.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </Fragment>
  </FinalCtaSection>

  <StickyCta
    context="August 10–14 · Toronto · $200 · Limited to 30 students"
    label="Register for August"
    href="/parent-approval/"
    secondaryLabel="Curriculum"
    secondaryHref="/curriculum/"
    revealAfter="#why-it-matters"
    suppressAfter="#register"
  />
</BaseLayout>
