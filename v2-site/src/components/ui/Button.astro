---
export interface Props {
  href?: string;
  type?: "button" | "submit" | "reset";
  variant?: "primary" | "secondary" | "accent" | "outline" | "text";
  size?: "small" | "medium" | "large";
  fullWidth?: boolean;
  disabled?: boolean;
  class?: string;
  ariaLabel?: string;
}

const {
  href,
  type = "button",
  variant = "primary",
  size = "medium",
  fullWidth = false,
  disabled = false,
  class: className = "",
  ariaLabel,
} = Astro.props;

const classes = [
  "button",
  `button--${variant}`,
  `button--${size}`,
  fullWidth && "button--full",
  className,
]
  .filter(Boolean)
  .join(" ");
---

{
  href ? (
    <a
      class={classes}
      href={disabled ? undefined : href}
      aria-label={ariaLabel}
      aria-disabled={disabled ? "true" : undefined}
      tabindex={disabled ? "-1" : undefined}
    >
      <slot />
    </a>
  ) : (
    <button
      class={classes}
      type={type}
      disabled={disabled}
      aria-label={ariaLabel}
    >
      <slot />
    </button>
  )
}

<style>
  .button {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    border: 2px solid transparent;
    border-radius: var(--radius-pill);
    padding: 0.75rem 1.25rem;
    font-family: var(--font-body);
    font-weight: 700;
    line-height: 1.1;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast),
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .button:hover:not(:disabled, [aria-disabled="true"]) {
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
  }

  .button:active:not(:disabled, [aria-disabled="true"]) {
    transform: translateY(0);
  }

  .button:disabled,
  .button[aria-disabled="true"] {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .button--primary {
    background: var(--color-primary);
    color: var(--color-on-primary);
  }

  .button--primary:hover:not(:disabled, [aria-disabled="true"]) {
    background: var(--color-primary-hover);
  }

  .button--secondary {
    background: var(--color-secondary);
    color: var(--color-on-secondary);
  }

  .button--secondary:hover:not(:disabled, [aria-disabled="true"]) {
    background: var(--color-secondary-hover);
  }

  .button--accent {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .button--accent:hover:not(:disabled, [aria-disabled="true"]) {
    background: var(--color-accent-hover);
  }

  .button--outline {
    border-color: currentColor;
    background: transparent;
    color: var(--color-primary);
  }

  .button--outline:hover:not(:disabled, [aria-disabled="true"]) {
    background: var(--color-surface-strong);
  }

  .button--text {
    min-height: auto;
    padding-inline: 0;
    background: transparent;
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .button--text:hover:not(:disabled, [aria-disabled="true"]) {
    box-shadow: none;
  }

  .button--small {
    min-height: 2.5rem;
    padding: 0.6rem 1rem;
    font-size: var(--text-xs);
  }

  .button--large {
    min-height: 3.5rem;
    border-radius: var(--radius-md);
    padding: 1rem 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 1.3rem + 1vw, 2.25rem);
    font-weight: 400;
    letter-spacing: var(--tracking-display);
    line-height: 0.95;
    text-transform: uppercase;
  }

  .button--full {
    width: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .button {
      transition: none;
    }

    .button:hover:not(:disabled, [aria-disabled="true"]) {
      transform: none;
    }
  }
</style>
