---
export interface Props {
  id?: string;
  as?: "section" | "div";
  tone?: "default" | "subtle" | "primary" | "secondary" | "accent";
  width?: "content" | "wide";
  spacing?: "compact" | "default" | "spacious";
  class?: string;
  ariaLabelledby?: string;
}

const {
  id,
  as: Tag = "section",
  tone = "default",
  width = "content",
  spacing = "default",
  class: className = "",
  ariaLabelledby,
} = Astro.props;
---

<Tag
  id={id}
  class:list={[
    "section",
    `section--${tone}`,
    `section--${spacing}`,
    className,
  ]}
  aria-labelledby={ariaLabelledby}
>
  <div class={width === "wide" ? "container-wide" : "container"}>
    <slot />
  </div>
</Tag>

<style>
  .section {
    padding-block: var(--space-6);
  }

  .section--compact {
    padding-block: var(--space-4);
  }

  .section--spacious {
    padding-block: clamp(var(--space-6), 8vw, 7rem);
  }

  .section--subtle {
    background: var(--color-surface-subtle);
  }

  .section--primary {
    background: var(--color-primary);
    color: var(--color-on-primary);
  }

  .section--secondary {
    background: var(--color-secondary);
    color: var(--color-on-secondary);
  }

  .section--accent {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }
</style>
