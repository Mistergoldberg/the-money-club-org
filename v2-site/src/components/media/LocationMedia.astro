---
import type { MediaItem } from "../../data/media";
import Button from "../ui/Button.astro";
import MediaFrame from "./MediaFrame.astro";

interface Props {
  media: MediaItem;
  venue: string;
  address: string;
  actionHref?: string;
  actionLabel?: string;
  showCaption?: boolean;
  showLocationDetails?: boolean;
}

const {
  media,
  venue,
  address,
  actionHref,
  actionLabel,
  showCaption = true,
  showLocationDetails = true,
} = Astro.props;
---

<div class="location-media">
  <MediaFrame
    media={media}
    showCaption={false}
    sizes="(min-width: 56rem) 46vw, 100vw"
  />
  {
    showLocationDetails && (
      <div class="location-media__label">
        <span aria-hidden="true">●</span>
        <p><strong>{venue}</strong><br />{address}</p>
      </div>
    )
  }
  {showCaption && media.caption && <p class="location-media__caption">{media.caption}</p>}
  {
    actionHref && actionLabel && (
      <div class="location-media__actions">
        <Button href={actionHref} size="large" fullWidth>{actionLabel}</Button>
      </div>
    )
  }
</div>

<style>
  .location-media {
    display: grid;
    gap: var(--space-3);
  }

  .location-media__label {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    width: 100%;
    margin: 0;
    padding: var(--space-3);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  .location-media__label span {
    color: var(--color-primary);
  }

  .location-media__label p {
    line-height: var(--line-copy);
  }

  .location-media__caption {
    padding-inline: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: var(--line-caption);
  }

  .location-media__actions {
    width: min(100%, 26rem);
  }

  @media (max-width: 35rem) {
    .location-media__actions {
      width: 100%;
    }
  }
</style>
