---
import type { MediaAspectRatio, MediaItem } from "../../data/media";

interface Props {
  media: MediaItem;
  aspectRatio?: MediaAspectRatio;
  showCaption?: boolean;
  class?: string;
  sizes?: string;
}

const {
  media,
  aspectRatio = media.aspectRatio ?? "natural",
  showCaption = true,
  class: className = "",
  sizes = "100vw",
} = Astro.props;

const ratios: Record<MediaAspectRatio, string> = {
  wide: "16 / 9",
  landscape: "3 / 2",
  square: "1 / 1",
  portrait: "4 / 5",
  natural: `${media.width} / ${media.height}`,
};

const alt = media.decorative ? "" : media.alt;
const hasCaption = showCaption && !media.decorative && (media.caption || media.credit);
---

<figure
  class:list={["media-frame", `media-frame--${aspectRatio}`, className]}
  style={`--media-aspect-ratio: ${ratios[aspectRatio]}; --media-object-position: ${media.objectPosition ?? "center"};`}
  aria-hidden={media.decorative ? "true" : undefined}
>
  <div class="media-frame__image">
    <img
      src={media.src}
      alt={alt}
      width={media.width}
      height={media.height}
      loading={media.priority ? "eager" : "lazy"}
      fetchpriority={media.priority ? "high" : "auto"}
      decoding="async"
      sizes={sizes}
    />
  </div>
  {
    hasCaption && (
      <figcaption>
        {media.caption && <span>{media.caption}</span>}
        {media.credit && <small>Photo: {media.credit}</small>}
      </figcaption>
    )
  }
</figure>

<style>
  .media-frame {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
    margin: 0;
  }

  .media-frame__image {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--media-aspect-ratio);
    border: 1px solid rgb(23 22 20 / 10%);
    border-radius: var(--radius-lg);
    background: var(--color-surface-strong);
    box-shadow: var(--shadow-md);
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--media-object-position);
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
    padding-inline: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: var(--line-caption);
  }

  figcaption span {
    max-width: 58ch;
  }

  figcaption small {
    font-size: inherit;
  }
</style>
