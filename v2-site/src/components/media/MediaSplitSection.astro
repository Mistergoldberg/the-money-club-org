---
import type { MediaItem } from "../../data/media";
import SectionGrid from "../layout/SectionGrid.astro";

interface Props {
  media: MediaItem;
  mediaSide?: "start" | "end";
  align?: "start" | "center";
}

const {
  media,
  mediaSide = "end",
  align = "center",
} = Astro.props;
---

<SectionGrid media={media} mediaSide={mediaSide} align={align}>
  <slot slot="heading" name="heading" />
  {Astro.slots.has("media") && <slot slot="media" name="media" />}
  <slot />
</SectionGrid>
