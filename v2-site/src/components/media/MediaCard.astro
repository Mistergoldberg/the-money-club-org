---
import type { MediaItem } from "../../data/media";
import MediaFrame from "./MediaFrame.astro";

interface Props {
  media: MediaItem;
  title?: string;
  showCaption?: boolean;
}

const { media, title, showCaption = true } = Astro.props;
---

<article class="media-card">
  <MediaFrame
    media={media}
    showCaption={showCaption}
    sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 48vw, 100vw"
  />
  {
    (title || Astro.slots.has("default")) && (
      <div class="media-card__body">
        {title && <h3>{title}</h3>}
        <slot />
      </div>
    )
  }
</article>

<style>
  .media-card {
    display: grid;
    grid-template-rows: auto 1fr;
    align-content: start;
    gap: var(--space-2);
    min-width: 0;
  }

  .media-card :global(.media-frame__image) {
    aspect-ratio: 3 / 2;
    box-shadow: var(--shadow-sm);
  }

  .media-card__body {
    display: grid;
    gap: var(--space-2);
  }

  h3 {
    font-size: var(--text-xl);
  }

  .media-card__body :global(p) {
    color: var(--color-text-muted);
    line-height: var(--line-copy);
  }
</style>
