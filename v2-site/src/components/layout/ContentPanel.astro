---
interface Props {
  tone?: "default" | "subtle" | "accent" | "trust";
  compact?: boolean;
  class?: string;
}

const {
  tone = "default",
  compact = false,
  class: className = "",
} = Astro.props;
---

<div
  class:list={[
    "content-panel",
    `content-panel--${tone}`,
    { "content-panel--compact": compact },
    className,
  ]}
>
  <slot />
</div>

<style>
  .content-panel {
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  .content-panel--compact {
    padding: var(--space-3);
    border-radius: var(--radius-md);
  }

  .content-panel--subtle {
    background: var(--color-surface-subtle);
  }

  .content-panel--accent {
    border-color: transparent;
    background: var(--color-accent);
  }

  .content-panel--trust {
    border-left: 0.35rem solid var(--color-success);
    background: var(--color-surface);
  }
</style>
