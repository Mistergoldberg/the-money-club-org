---
import Button from "../ui/Button.astro";

export interface Props {
  label: string;
  href: string;
  context?: string;
}

const { label, href, context } = Astro.props;
---

<aside class="sticky-cta" aria-label="Next step">
  <div class="sticky-cta__inner container">
    {context && <p>{context}</p>}
    <Button href={href} variant="secondary" size="medium">
      {label}
    </Button>
  </div>
</aside>

<style>
  .sticky-cta {
    position: sticky;
    z-index: 40;
    bottom: 0;
    border-top: 1px solid var(--color-border);
    background: rgb(255 255 255 / 96%);
    box-shadow: 0 -0.5rem 1.5rem rgb(23 22 20 / 8%);
    backdrop-filter: blur(0.75rem);
  }

  .sticky-cta__inner {
    display: flex;
    min-height: 4.5rem;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-4);
    padding-block: var(--space-2);
  }

  p {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  @media (max-width: 40rem) {
    .sticky-cta__inner {
      justify-content: stretch;
    }

    p {
      display: none;
    }

    :global(.sticky-cta .button) {
      width: 100%;
    }
  }
</style>
