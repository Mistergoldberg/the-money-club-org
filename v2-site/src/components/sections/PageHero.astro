---
import Button from "../ui/Button.astro";

interface Props {
  eyebrow?: string;
  headline: string;
  body: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel: string;
  secondaryHref: string;
}

const {
  eyebrow,
  headline,
  body,
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
} = Astro.props;
---

<section class="page-hero" aria-labelledby="homepage-title">
  <div class="container page-hero__inner">
    <div class="page-hero__copy">
      {eyebrow && <p class="page-hero__eyebrow">{eyebrow}</p>}
      <h1 id="homepage-title">{headline}</h1>
      <p class="page-hero__body">{body}</p>
      <div class="page-hero__actions">
        <Button href={primaryHref} size="large">{primaryLabel}</Button>
        <Button href={secondaryHref} variant="outline" size="large">
          {secondaryLabel}
        </Button>
      </div>
    </div>
    <div class="page-hero__visual">
      <slot name="visual" />
    </div>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(var(--space-6), 9vw, 7.5rem);
    background:
      radial-gradient(circle at 82% 18%, rgb(240 180 58 / 0.22), transparent 22rem),
      linear-gradient(145deg, var(--color-surface) 0%, var(--color-surface-subtle) 100%);
  }

  .page-hero::before {
    position: absolute;
    top: -9rem;
    left: -7rem;
    width: 20rem;
    height: 20rem;
    border: 2.5rem solid rgb(30 138 149 / 0.08);
    border-radius: var(--radius-pill);
    content: "";
  }

  .page-hero__inner {
    position: relative;
    display: grid;
    align-items: center;
    gap: var(--space-6);
  }

  .page-hero__copy {
    display: grid;
    gap: var(--space-4);
    max-width: 48rem;
  }

  .page-hero__eyebrow {
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 15ch;
    font-size: clamp(3.4rem, 8vw, 6.75rem);
    line-height: 0.9;
  }

  .page-hero__body {
    max-width: 45rem;
    color: var(--color-text-muted);
    font-size: clamp(var(--text-lg), 2vw, var(--text-xl));
    line-height: var(--line-height-relaxed);
  }

  .page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .page-hero__visual {
    min-width: 0;
  }

  @media (min-width: 64rem) {
    .page-hero__inner {
      grid-template-columns: minmax(0, 1.2fr) minmax(22rem, 0.8fr);
    }
  }

  @media (max-width: 35rem) {
    .page-hero__actions :global(.button) {
      width: 100%;
    }
  }
</style>
