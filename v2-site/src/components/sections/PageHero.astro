---
import Button from "../ui/Button.astro";

interface Props {
  eyebrow?: string;
  headline: string;
  body: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel: string;
  secondaryHref: string;
  proofPoints?: readonly string[];
  visualOnMobile?: boolean;
}

const {
  eyebrow,
  headline,
  body,
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
  proofPoints = [],
  visualOnMobile = false,
} = Astro.props;
---

<section class="page-hero" aria-labelledby="homepage-title">
  <div class="container page-hero__inner">
    <div class="page-hero__heading">
      {eyebrow && <p class="page-hero__eyebrow">{eyebrow}</p>}
      <h1 id="homepage-title">{headline}</h1>
    </div>
    <div
      class:list={[
        "page-hero__visual",
        { "page-hero__visual--hidden-mobile": !visualOnMobile },
      ]}
    >
      <slot name="visual" />
    </div>
    <div class="page-hero__actions">
      <Button href={primaryHref} size="large">{primaryLabel}</Button>
      <Button href={secondaryHref} variant="outline" size="large">
        {secondaryLabel}
      </Button>
    </div>
    <p class="page-hero__body">{body}</p>
    {
      proofPoints.length > 0 && (
        <ul class="page-hero__proofs" role="list">
          {proofPoints.map((point) => (
            <li>
              <span aria-hidden="true">✓</span>
              {point}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(var(--space-5), 5vw, 4.5rem);
    background:
      radial-gradient(circle at 82% 18%, rgb(240 180 58 / 0.22), transparent 22rem),
      linear-gradient(145deg, var(--color-surface) 0%, var(--color-surface-subtle) 100%);
  }

  .page-hero::before {
    position: absolute;
    top: -9rem;
    left: -7rem;
    width: 20rem;
    height: 20rem;
    border: 2.5rem solid rgb(30 138 149 / 0.08);
    border-radius: var(--radius-pill);
    content: "";
  }

  .page-hero__inner {
    position: relative;
    display: grid;
    grid-template-areas:
      "heading"
      "visual"
      "actions"
      "body"
      "proofs";
    align-items: center;
    gap: var(--space-3);
  }

  .page-hero__heading {
    grid-area: heading;
    display: grid;
    gap: var(--space-3);
    max-width: 48rem;
  }

  .page-hero__eyebrow {
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 15ch;
    font-size: clamp(3.4rem, 6.2vw, 5.75rem);
    line-height: 0.9;
  }

  .page-hero__body {
    grid-area: body;
    max-width: 45rem;
    color: var(--color-text-muted);
    font-size: clamp(var(--text-lg), 2vw, var(--text-xl));
    line-height: 1.58;
  }

  .page-hero__proofs {
    grid-area: proofs;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding: 0;
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    list-style: none;
  }

  .page-hero__proofs li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }

  .page-hero__proofs span {
    display: grid;
    width: 1.5rem;
    height: 1.5rem;
    place-items: center;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-size: var(--text-xs);
  }

  .page-hero__actions {
    grid-area: actions;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .page-hero__visual {
    grid-area: visual;
    min-width: 0;
  }

  @media (min-width: 64rem) {
    .page-hero__inner {
      grid-template-columns: minmax(0, 1.2fr) minmax(22rem, 0.8fr);
      grid-template-areas:
        "heading visual"
        "actions visual"
        "body visual"
        "proofs visual";
      column-gap: var(--space-6);
      row-gap: var(--space-3);
    }
  }

  @media (max-width: 35rem) {
    .page-hero {
      padding-block: var(--space-6);
    }

    .page-hero__proofs {
      display: grid;
      gap: var(--space-2);
    }

    .page-hero__actions {
      margin-block: var(--space-1);
    }

    .page-hero__actions :global(.button) {
      width: 100%;
    }
  }

  @media (max-width: 47.99rem) {
    .page-hero__visual--hidden-mobile {
      display: none !important;
    }
  }
</style>
