---
import type { BuildStep } from "../../data/homepage";

interface Props {
  steps: readonly BuildStep[];
}

const { steps } = Astro.props;
---

<ol class="build-cycle">
  {steps.map((step, index) => (
    <li>
      <span class="build-cycle__index">{index + 1}</span>
      <div>
        <h3>{step.title}</h3>
        <p>{step.description}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .build-cycle {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    position: relative;
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: var(--space-3);
    align-items: start;
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-top: 0.3rem solid var(--color-primary);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  li:not(:last-child)::after {
    position: absolute;
    z-index: 0;
    top: 4.2rem;
    bottom: calc(var(--space-2) * -1 - 1px);
    left: calc(var(--space-3) + 1.5rem);
    width: 1px;
    background: var(--color-primary);
    content: "";
  }

  .build-cycle__index {
    position: relative;
    z-index: 1;
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border-radius: var(--radius-pill);
    background: var(--color-primary);
    color: var(--color-text-on-dark);
    font-family: var(--font-display);
    font-size: var(--text-xl);
  }

  h3 {
    font-size: var(--text-xl);
  }

  p {
    margin-top: var(--space-1);
    color: var(--color-text-muted);
    line-height: var(--line-height-relaxed);
  }

  @media (min-width: 42rem) {
    .build-cycle {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    li {
      grid-template-columns: 2.75rem minmax(0, 1fr);
      min-height: 10.5rem;
    }

    li:not(:last-child)::after {
      content: none;
    }

    h3 {
      font-size: var(--text-xl);
    }
  }

  @media (min-width: 68rem) {
    .build-cycle {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    li {
      min-height: 11rem;
    }
  }
</style>
