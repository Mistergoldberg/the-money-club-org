---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: "start" | "center";
  headingId?: string;
}

const { eyebrow, title, lead, align = "start", headingId } = Astro.props;
---

<header class:list={["section-intro", `section-intro--${align}`]}>
  {eyebrow && <p class="section-intro__eyebrow">{eyebrow}</p>}
  <h2 id={headingId}>{title}</h2>
  {lead && <p class="section-intro__lead">{lead}</p>}
</header>

<style>
  .section-intro {
    display: grid;
    gap: var(--space-3);
    max-width: 52rem;
    margin-bottom: var(--space-5);
  }

  .section-intro--center {
    margin-inline: auto;
    text-align: center;
  }

  .section-intro__eyebrow {
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h2 {
    font-size: var(--text-3xl);
  }

  .section-intro__lead {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: var(--line-lead);
  }

  @media (min-width: 48rem) {
    h2 {
      font-size: var(--text-4xl);
    }
  }
</style>
