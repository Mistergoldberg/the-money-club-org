---
interface Props {
  title: string;
  paragraphs: readonly string[];
  signature: string;
  role: string;
  headingId?: string;
}

const { title, paragraphs, signature, role, headingId } = Astro.props;
---

<article class="founder-note">
  <div class="founder-note__mark" aria-hidden="true">JG</div>
  <div class="founder-note__content">
    <p class="founder-note__eyebrow">From the founder</p>
    <h2 id={headingId}>{title}</h2>
    <div class="founder-note__body">
      {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <footer>
      <strong>{signature}</strong>
      <span>{role}</span>
    </footer>
  </div>
</article>

<style>
  .founder-note {
    display: grid;
    gap: var(--space-4);
    max-width: 62rem;
    margin-inline: auto;
    padding: clamp(var(--space-4), 6vw, var(--space-6));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(135deg, rgb(30 138 149 / 0.06), transparent 45%),
      var(--color-surface);
    box-shadow: var(--shadow-md);
  }

  .founder-note__mark {
    display: grid;
    width: 5rem;
    height: 5rem;
    place-items: center;
    border-radius: var(--radius-pill);
    background: var(--color-secondary);
    color: var(--color-text-on-dark);
    font-family: var(--font-display);
    font-size: var(--text-2xl);
  }

  .founder-note__content {
    min-width: 0;
  }

  .founder-note__eyebrow {
    margin-bottom: var(--space-2);
    color: var(--color-secondary);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h2 {
    font-size: var(--text-3xl);
  }

  .founder-note__body {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    line-height: var(--line-height-relaxed);
  }

  footer {
    display: grid;
    gap: 0.15rem;
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  footer strong {
    color: var(--color-text);
  }

  footer span {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  @media (min-width: 48rem) {
    .founder-note {
      grid-template-columns: 7rem minmax(0, 1fr);
    }

    h2 {
      font-size: var(--text-4xl);
    }
  }
</style>
