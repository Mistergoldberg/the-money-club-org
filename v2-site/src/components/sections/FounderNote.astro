---
import type { MediaItem } from "../../data/media";
import SectionMedia from "../media/SectionMedia.astro";

interface Props {
  title: string;
  paragraphs: readonly string[];
  signature: string;
  role: string;
  headingId?: string;
  initials?: string;
  media?: MediaItem;
}

const {
  title,
  paragraphs,
  signature,
  role,
  headingId,
  initials,
  media,
} = Astro.props;
---

<article class:list={["founder-note", { "founder-note--with-media": media }]}>
  <div class="founder-note__header">
    {initials && <span class="founder-note__mark" aria-hidden="true">{initials}</span>}
    <p class="founder-note__eyebrow">From the founder</p>
  </div>
  <h2 id={headingId}>{title}</h2>
  {
    media && (
      <div class="founder-note__media">
        <SectionMedia media={media} placement="profile" showCaption={false} />
      </div>
    )
  }
  <div class="founder-note__body">
    {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>
  <footer>
    <strong>{signature}</strong>
    <span>{role}</span>
  </footer>
</article>

<style>
  .founder-note {
    position: relative;
    display: grid;
    grid-template-areas:
      "header"
      "title"
      "media"
      "body"
      "footer";
    gap: var(--space-4);
    padding: clamp(var(--space-4), 6vw, var(--space-6));
    border: 1px solid var(--color-border);
    border-top: 0.4rem solid var(--color-secondary);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(135deg, rgb(30 138 149 / 0.06), transparent 45%),
      var(--color-surface);
    box-shadow: var(--shadow-md);
  }

  .founder-note__mark {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border-radius: var(--radius-sm);
    background: var(--color-secondary);
    color: var(--color-text-on-dark);
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }

  .founder-note__header {
    grid-area: header;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .founder-note__eyebrow {
    color: var(--color-secondary);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h2 {
    grid-area: title;
    font-size: var(--text-3xl);
  }

  .founder-note__media {
    grid-area: media;
    min-width: 0;
  }

  .founder-note__body {
    grid-area: body;
    display: grid;
    gap: var(--space-3);
    color: var(--color-text-muted);
    line-height: var(--line-copy);
  }

  footer {
    grid-area: footer;
    display: grid;
    gap: 0.15rem;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  footer strong {
    color: var(--color-text);
  }

  footer span {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  @media (min-width: 48rem) {
    .founder-note--with-media {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-areas:
        "media media media media header header header header header header header header"
        "media media media media title title title title title title title title"
        "media media media media body body body body body body body body"
        "media media media media footer footer footer footer footer footer footer footer";
      column-gap: clamp(var(--space-4), 2.5vw, var(--space-5));
      align-items: start;
    }

    .founder-note__media {
      align-self: start;
    }

    h2 {
      font-size: var(--text-4xl);
    }
  }
</style>
