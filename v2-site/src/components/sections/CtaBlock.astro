---
import Button from "../ui/Button.astro";
import Card from "../ui/Card.astro";

export interface Props {
  eyebrow?: string;
  title: string;
  body: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  tone?: "default" | "primary" | "secondary" | "accent";
  unresolvedReference?: boolean;
}

const {
  eyebrow,
  title,
  body,
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
  tone = "default",
  unresolvedReference = false,
} = Astro.props;
---

<Card as="aside" tone={tone} padding="large" class="cta-block">
  <div class="cta-block__copy flow">
    {eyebrow && <p class="cta-block__eyebrow">{eyebrow}</p>}
    <h2>{title}</h2>
    <p>{body}</p>
    {
      unresolvedReference && (
        <p class="cta-block__note">
          This provisional pattern uses current end-of-page CTA and interest-deck
          behavior until the exact "end decks" reference is supplied.
        </p>
      )
    }
  </div>

  <div class="cta-block__actions">
    <Button href={primaryHref} variant="accent" size="large">
      {primaryLabel}
    </Button>
    {
      secondaryLabel && secondaryHref && (
        <Button href={secondaryHref} variant="outline" size="large">
          {secondaryLabel}
        </Button>
      )
    }
  </div>
</Card>

<style>
  .cta-block {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(16rem, 0.65fr);
    gap: var(--space-5);
    align-items: center;
  }

  .cta-block__copy {
    --flow-space: var(--space-3);
  }

  .cta-block__eyebrow {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cta-block__copy h2 {
    font-size: var(--text-heading);
  }

  .cta-block__note {
    max-width: var(--measure-copy);
    font-size: var(--text-xs);
    opacity: 0.8;
  }

  .cta-block__actions {
    display: grid;
    gap: var(--space-3);
  }

  @media (max-width: 48rem) {
    .cta-block {
      grid-template-columns: 1fr;
    }
  }
</style>
