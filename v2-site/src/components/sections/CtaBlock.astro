---
import Button from "../ui/Button.astro";
import Card from "../ui/Card.astro";

export interface Props {
  eyebrow?: string;
  title: string;
  body?: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  tone?: "default" | "primary" | "secondary" | "accent";
  unresolvedReference?: boolean;
  headingId?: string;
  featured?: boolean;
}

const {
  eyebrow,
  title,
  body,
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
  tone = "default",
  unresolvedReference = false,
  headingId,
  featured = false,
} = Astro.props;
---

<Card
  as="aside"
  tone={tone}
  padding="large"
  class={`cta-block${featured ? " cta-block--featured" : ""}`}
>
  <div class="cta-block__copy flow">
    {eyebrow && <p class="cta-block__eyebrow">{eyebrow}</p>}
    <h2 id={headingId}>{title}</h2>
    {Astro.slots.has("copy") ? <slot name="copy" /> : body && <p>{body}</p>}
    {
      unresolvedReference && (
        <p class="cta-block__note">
          This provisional pattern uses current end-of-page CTA and interest-deck
          behavior until the exact "end decks" reference is supplied.
        </p>
      )
    }
  </div>

  <div class="cta-block__actions">
    <Button href={primaryHref} variant="accent" size="large">
      {primaryLabel}
    </Button>
    {
      secondaryLabel && secondaryHref && (
        <Button
          href={secondaryHref}
          variant={tone === "default" ? "outline" : "contrast"}
          size="large"
        >
          {secondaryLabel}
        </Button>
      )
    }
  </div>
</Card>

<style>
  :global(.cta-block) {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(16rem, 0.65fr);
    gap: var(--space-5);
    align-items: center;
    overflow: hidden;
  }

  :global(.cta-block--featured) {
    border: 0;
    box-shadow: var(--shadow-lg);
  }

  :global(.cta-block--featured::before) {
    position: absolute;
    top: -5rem;
    right: -4rem;
    width: 15rem;
    height: 15rem;
    border: 2rem solid rgb(240 180 58 / 0.2);
    border-radius: var(--radius-pill);
    content: "";
  }

  :global(.cta-block--featured::after) {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 42%;
    height: 0.45rem;
    background: var(--color-accent);
    content: "";
  }

  .cta-block__copy {
    position: relative;
    z-index: 1;
    --flow-space: var(--space-3);
  }

  .cta-block__eyebrow {
    width: fit-content;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.14);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cta-block__copy h2 {
    font-size: var(--text-heading);
  }

  .cta-block__note {
    max-width: var(--measure-copy);
    font-size: var(--text-xs);
    opacity: 0.8;
  }

  .cta-block__actions {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-3);
  }

  @media (max-width: 48rem) {
    :global(.cta-block) {
      grid-template-columns: 1fr;
    }

    :global(.cta-block--featured::before) {
      top: -7rem;
      right: -7rem;
    }
  }
</style>
