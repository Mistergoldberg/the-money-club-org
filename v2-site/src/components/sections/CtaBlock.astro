---
import type { MediaItem } from "../../data/media";
import MediaFrame from "../media/MediaFrame.astro";
import Button from "../ui/Button.astro";
import Card from "../ui/Card.astro";

export interface Props {
  eyebrow?: string;
  title: string;
  body?: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  tone?: "default" | "primary" | "secondary" | "accent";
  unresolvedReference?: boolean;
  headingId?: string;
  featured?: boolean;
  media?: MediaItem;
}

const {
  eyebrow,
  title,
  body,
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
  tone = "default",
  unresolvedReference = false,
  headingId,
  featured = false,
  media,
} = Astro.props;
---

<Card
  as="aside"
  tone={tone}
  padding="large"
  class={`cta-block${featured ? " cta-block--featured" : ""}${media ? " cta-block--with-media" : ""}`}
>
  <div class="cta-block__heading flow">
    {eyebrow && <p class="cta-block__eyebrow">{eyebrow}</p>}
    <h2 id={headingId}>{title}</h2>
  </div>

  {
    media && (
      <div class="cta-block__media">
        <MediaFrame
          media={media}
          showCaption={false}
          sizes="(min-width: 48rem) 34vw, 100vw"
        />
      </div>
    )
  }

  <div class="cta-block__copy flow">
    {Astro.slots.has("copy") ? <slot name="copy" /> : body && <p>{body}</p>}
    {
      unresolvedReference && (
        <p class="cta-block__note">
          This provisional pattern uses current end-of-page CTA and interest-deck
          behavior until the exact "end decks" reference is supplied.
        </p>
      )
    }
  </div>

  <div class="cta-block__actions">
    <Button href={primaryHref} variant="accent" size="large">
      {primaryLabel}
    </Button>
    {
      secondaryLabel && secondaryHref && (
        <Button
          href={secondaryHref}
          variant={tone === "default" ? "outline" : "contrast"}
          size="large"
        >
          {secondaryLabel}
        </Button>
      )
    }
  </div>
</Card>

<style>
  :global(.cta-block) {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-4) clamp(var(--space-4), 2.5vw, var(--space-5));
    align-items: start;
    overflow: hidden;
  }

  :global(.cta-block:not(.cta-block--with-media)) {
    grid-template-areas:
      "heading heading heading heading heading heading copy copy copy copy copy copy"
      "actions actions actions actions actions actions copy copy copy copy copy copy";
  }

  :global(.cta-block--with-media) {
    grid-template-areas:
      "media media media media heading heading heading heading heading heading heading heading"
      "media media media media copy copy copy copy copy copy copy copy"
      "media media media media actions actions actions actions actions actions actions actions";
  }

  :global(.cta-block--featured) {
    border: 0;
    box-shadow: var(--shadow-lg);
  }

  :global(.cta-block--featured::before) {
    position: absolute;
    top: -5rem;
    right: -4rem;
    width: 15rem;
    height: 15rem;
    border: 2rem solid rgb(240 180 58 / 0.2);
    border-radius: var(--radius-pill);
    content: "";
  }

  :global(.cta-block--featured::after) {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 42%;
    height: 0.45rem;
    background: var(--color-accent);
    content: "";
  }

  .cta-block__heading,
  .cta-block__copy {
    position: relative;
    z-index: 1;
    --flow-space: var(--space-3);
  }

  .cta-block__heading {
    grid-area: heading;
  }

  .cta-block__copy {
    grid-area: copy;
  }

  .cta-block__media {
    z-index: 1;
    grid-area: media;
    min-width: 0;
  }

  .cta-block__media :global(.media-frame__image) {
    border-color: rgb(255 255 255 / 18%);
    box-shadow: none;
  }

  .cta-block__eyebrow {
    width: fit-content;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.14);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cta-block__copy h2 {
    font-size: var(--text-heading);
  }

  .cta-block__note {
    max-width: var(--measure-copy);
    font-size: var(--text-xs);
    opacity: 0.8;
  }

  .cta-block__actions {
    position: relative;
    z-index: 1;
    display: flex;
    grid-area: actions;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .cta-block__actions :global(.button) {
    flex: 1 1 15rem;
  }

  @media (max-width: 48rem) {
    :global(.cta-block) {
      grid-template-columns: 1fr;
    }

    :global(.cta-block:not(.cta-block--with-media)) {
      grid-template-areas:
        "heading"
        "copy"
        "actions";
    }

    .cta-block__actions {
      display: grid;
    }

    :global(.cta-block--with-media) {
      grid-template-columns: 1fr;
      grid-template-areas:
        "heading"
        "media"
        "copy"
        "actions";
    }

    :global(.cta-block--featured::before) {
      top: -7rem;
      right: -7rem;
    }
  }
</style>
