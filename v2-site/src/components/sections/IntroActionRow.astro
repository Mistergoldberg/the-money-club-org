---
import Button from "../ui/Button.astro";

interface Props {
  actionHref: string;
  actionLabel: string;
  actionVariant?: "primary" | "secondary" | "accent" | "outline" | "text" | "contrast";
  actionSize?: "small" | "medium" | "large";
}

const {
  actionHref,
  actionLabel,
  actionVariant = "outline",
  actionSize = "large",
} = Astro.props;
---

<div class="intro-action-row">
  <div class="intro-action-row__copy">
    <slot />
  </div>
  <Button href={actionHref} variant={actionVariant} size={actionSize}>
    {actionLabel}
  </Button>
</div>

<style>
  .intro-action-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .intro-action-row__copy {
    flex: 1 1 22rem;
  }

  .intro-action-row :global(.button) {
    flex: 0 0 auto;
  }

  @media (max-width: 35rem) {
    .intro-action-row :global(.button) {
      width: 100%;
    }
  }
</style>
