---
import ContentPanel from "../layout/ContentPanel.astro";

export interface Props {
  title?: string;
  points?: readonly string[];
}

const {
  title = "What parents can expect",
  points = [
    "Clear program expectations before any commitment.",
    "Direct explanations of safety, supervision, and next steps.",
    "Consistent form, payment, and confirmation states.",
  ],
} = Astro.props;
---

<ContentPanel tone="trust" compact class="confidence-box">
  <div class="confidence-box__icon" aria-hidden="true">✓</div>
  <div class="flow">
    <h3>{title}</h3>
    <ul>
      {points.map((point) => <li>{point}</li>)}
    </ul>
  </div>
</ContentPanel>

<style>
  :global(.confidence-box) {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
  }

  .confidence-box__icon {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border-radius: 50%;
    background: var(--color-success);
    color: var(--color-surface);
    font-weight: 700;
  }

  ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2) var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    position: relative;
    padding-left: 1.1rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--line-copy);
  }

  li::before {
    position: absolute;
    top: 0.6em;
    left: 0;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--color-success);
    content: "";
  }

  @media (max-width: 35rem) {
    :global(.confidence-box) {
      grid-template-columns: 1fr;
    }

    ul {
      grid-template-columns: 1fr;
    }
  }
</style>
