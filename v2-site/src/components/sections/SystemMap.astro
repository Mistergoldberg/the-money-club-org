---
interface Props {
  eyebrow?: string;
  title?: string;
  centerLabel?: string;
  concepts?: readonly string[];
  caption?: string;
  tone?: "light" | "dark";
}

const {
  eyebrow = "A system of choices",
  title = "See how money moves",
  centerLabel = "Money moves",
  concepts = ["Price", "Cost", "Value", "Risk", "Margin", "Choice"],
  caption,
  tone = "light",
} = Astro.props;
---

<figure
  class:list={["system-map", `system-map--${tone}`]}
  aria-label={`${title}: ${concepts.join(", ")}.`}
>
  <figcaption class="system-map__heading">
    <span>{eyebrow}</span>
    <strong>{title}</strong>
  </figcaption>
  <div class="system-map__diagram" aria-hidden="true">
    <div class="system-map__orbit"></div>
    <div class="system-map__core">
      <strong>{centerLabel}</strong>
    </div>
    <ul class="system-map__concepts">
      {concepts.map((concept, index) => (
        <li style={`--angle: ${(index * 360) / concepts.length}deg`}>{concept}</li>
      ))}
    </ul>
  </div>
  {caption && <p class="system-map__caption">{caption}</p>}
</figure>

<style>
  .system-map {
    display: grid;
    gap: var(--space-3);
    width: min(100%, 29rem);
    margin-inline: auto;
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-lg);
  }

  .system-map--dark {
    border-color: transparent;
    background:
      radial-gradient(circle at 80% 20%, rgb(240 180 58 / 0.24), transparent 12rem),
      var(--color-text);
    color: var(--color-text-on-dark);
  }

  .system-map__heading {
    display: grid;
    gap: 0.2rem;
  }

  .system-map__heading span {
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .system-map--dark .system-map__heading span {
    color: var(--color-accent);
  }

  .system-map__heading strong {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-regular);
    letter-spacing: var(--tracking-display);
    line-height: 0.95;
    text-transform: uppercase;
  }

  .system-map__diagram {
    position: relative;
    width: min(100%, 20rem);
    aspect-ratio: 1;
    margin-inline: auto;
  }

  .system-map__orbit {
    position: absolute;
    inset: 17%;
    border: 1px solid rgb(30 138 149 / 0.48);
    border-radius: var(--radius-pill);
  }

  .system-map__orbit::before,
  .system-map__orbit::after {
    position: absolute;
    inset: 11%;
    border: 1px dashed rgb(140 98 167 / 0.35);
    border-radius: inherit;
    content: "";
    transform: rotate(25deg);
  }

  .system-map__orbit::after {
    transform: rotate(-25deg);
  }

  .system-map__core {
    position: absolute;
    inset: 32%;
    display: grid;
    place-content: center;
    border: 0.55rem solid rgb(255 255 255 / 0.82);
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    box-shadow: var(--shadow-lg);
    color: var(--color-on-accent);
    text-align: center;
  }

  .system-map__core strong {
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 5vw, 2.8rem);
    font-weight: var(--font-weight-regular);
    line-height: 0.9;
    text-transform: uppercase;
  }

  .system-map__concepts {
    position: absolute;
    inset: 0;
    list-style: none;
  }

  .system-map__concepts li {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    min-width: 5.75rem;
    min-height: 2.75rem;
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    transform:
      rotate(var(--angle))
      translateX(clamp(6.5rem, 22vw, 8.1rem))
      rotate(calc(var(--angle) * -1));
  }

  .system-map--dark .system-map__concepts li {
    border-color: rgb(255 255 255 / 0.22);
    background: rgb(255 255 255 / 0.96);
  }

  .system-map__caption {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--line-height-relaxed);
  }

  .system-map--dark .system-map__caption {
    color: rgb(255 255 255 / 0.78);
  }

  @media (max-width: 25rem) {
    .system-map {
      padding: var(--space-3);
    }

    .system-map__concepts li {
      min-width: 4.75rem;
      font-size: var(--text-xs);
      transform:
        rotate(var(--angle))
        translateX(6.5rem)
        rotate(calc(var(--angle) * -1));
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .system-map__orbit {
      animation: drift 18s ease-in-out infinite alternate;
    }

    @keyframes drift {
      to {
        transform: rotate(8deg);
      }
    }
  }
</style>
