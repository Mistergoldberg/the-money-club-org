---
import Card from "../ui/Card.astro";
import type { HomeFeature } from "../../data/homepage";

interface Props {
  items: readonly HomeFeature[];
}

const { items } = Astro.props;
---

<div class="feature-grid">
  {items.map((item, index) => (
    <Card className="feature-card">
      <span class="feature-card__number" aria-hidden="true">
        {String(index + 1).padStart(2, "0")}
      </span>
      <h3>{item.title}</h3>
      <p>{item.description}</p>
    </Card>
  ))}
</div>

<style>
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-3);
  }

  .feature-grid :global(.feature-card) {
    position: relative;
    overflow: hidden;
    min-height: 13rem;
  }

  .feature-grid :global(.feature-card::after) {
    position: absolute;
    right: -2rem;
    bottom: -2.5rem;
    width: 7rem;
    height: 7rem;
    border: 1rem solid rgb(30 138 149 / 0.08);
    border-radius: var(--radius-pill);
    content: "";
  }

  .feature-card__number {
    color: var(--color-primary);
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: 1;
  }

  h3 {
    font-size: var(--text-xl);
  }

  p {
    color: var(--color-text-muted);
    line-height: var(--line-height-relaxed);
  }
</style>
