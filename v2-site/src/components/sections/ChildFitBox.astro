---
import Card from "../ui/Card.astro";

export interface Props {
  title?: string;
  positiveSignals?: readonly string[];
  discussFirst?: readonly string[];
}

const {
  title = "Is this right for my child?",
  positiveSignals = [
    "They are curious about how ideas become real products.",
    "They are ready to learn through making, testing, and reflection.",
    "They benefit from practical context for money and decision-making.",
  ],
  discussFirst = [],
} = Astro.props;
---

<Card as="aside" padding="large" class="fit-box">
  <h3>{title}</h3>
  <div class:list={["fit-box__grid", { "fit-box__grid--single": discussFirst.length === 0 }]}>
    <div>
      <h4>Good signals</h4>
      <ul>
        {positiveSignals.map((signal) => <li>{signal}</li>)}
      </ul>
    </div>
    {
      discussFirst.length > 0 && (
        <div>
          <h4>Talk with us first</h4>
          <ul>
            {discussFirst.map((signal) => <li>{signal}</li>)}
          </ul>
        </div>
      )
    }
  </div>
</Card>

<style>
  :global(.fit-box) {
    display: grid;
    gap: var(--space-4);
  }

  .fit-box__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .fit-box__grid--single {
    grid-template-columns: 1fr;
  }

  .fit-box__grid > div {
    padding: var(--space-3);
    border-radius: var(--radius-md);
    background: var(--color-surface-subtle);
  }

  h4 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lead);
    line-height: 1.2;
  }

  ul {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding-inline-start: 1.2em;
  }

  @media (max-width: 42rem) {
    .fit-box__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
