---
import ContentPanel from "../layout/ContentPanel.astro";

export interface Props {
  title?: string;
  positiveSignals?: readonly string[];
  discussFirst?: readonly string[];
}

const {
  title = "Is this right for my child?",
  positiveSignals = [
    "They are curious about how ideas become real products.",
    "They are ready to learn through making, testing, and reflection.",
    "They benefit from practical context for money and decision-making.",
  ],
  discussFirst = [],
} = Astro.props;
---

<ContentPanel tone="subtle" compact class="fit-box">
  <h3>{title}</h3>
  <div class:list={["fit-box__grid", { "fit-box__grid--single": discussFirst.length === 0 }]}>
    <div>
      <h4>Good signals</h4>
      <ul>
        {positiveSignals.map((signal) => <li>{signal}</li>)}
      </ul>
    </div>
    {
      discussFirst.length > 0 && (
        <div>
          <h4>Talk with us first</h4>
          <ul>
            {discussFirst.map((signal) => <li>{signal}</li>)}
          </ul>
        </div>
      )
    }
  </div>
</ContentPanel>

<style>
  :global(.fit-box) {
    display: grid;
    gap: var(--space-3);
  }

  .fit-box__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .fit-box__grid--single {
    grid-template-columns: 1fr;
  }

  .fit-box__grid > div {
    min-width: 0;
  }

  h4 {
    margin: 0 0 var(--space-2);
    color: var(--color-primary);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    position: relative;
    padding-left: 1.35rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  li::before {
    position: absolute;
    top: 0.55em;
    left: 0;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--color-accent);
    content: "";
  }

  @media (max-width: 42rem) {
    .fit-box__grid,
    ul {
      grid-template-columns: 1fr;
    }
  }
</style>
