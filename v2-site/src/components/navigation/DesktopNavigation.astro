---
import {
  headerRoutes,
  isCurrentRoute,
  learningModules,
  primaryCtaRoute,
} from "../../data/navigation";
import Button from "../ui/Button.astro";

export interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const primaryRoutes = headerRoutes.filter((route) => route.id !== "home");
---

<div class="desktop-navigation">
  <nav aria-label="Primary navigation">
    <ul role="list">
      {
        primaryRoutes.map((route) =>
          route.id === "learning-catalogue" ? (
            <li>
              <details class="nav-dropdown">
                <summary
                  aria-current={
                    isCurrentRoute(currentPath, route.href) ? "page" : undefined
                  }
                >
                  {route.shortLabel ?? route.label}
                </summary>
                <ul class="nav-dropdown__panel" role="list">
                  {learningModules.map((module) => (
                    <li>
                      <a href={module.href}>{module.label}</a>
                    </li>
                  ))}
                </ul>
              </details>
            </li>
          ) : (
            <li>
              <a
                href={route.href}
                aria-current={
                  isCurrentRoute(currentPath, route.href) ? "page" : undefined
                }
              >
                {route.shortLabel ?? route.label}
              </a>
            </li>
          ),
        )
      }
    </ul>
  </nav>

  <Button href={primaryCtaRoute.href} variant="secondary" size="small">
    {primaryCtaRoute.label}
  </Button>
</div>

<style>
  .desktop-navigation {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-4);
  }

  nav ul {
    display: flex;
    align-items: center;
    gap: clamp(var(--space-3), 2.2vw, var(--space-5));
  }

  nav a {
    position: relative;
    display: block;
    padding-block: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  nav a::after {
    position: absolute;
    right: 0;
    bottom: 0.2rem;
    left: 0;
    height: 2px;
    background: var(--color-primary);
    content: "";
    transform: scaleX(0);
    transform-origin: center;
    transition: transform var(--transition-fast);
  }

  nav a:hover::after,
  nav a[aria-current="page"]::after {
    transform: scaleX(1);
  }

  .nav-dropdown {
    position: relative;
  }

  .nav-dropdown summary {
    position: relative;
    display: block;
    padding-block: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 700;
    list-style: none;
    white-space: nowrap;
    cursor: pointer;
  }

  .nav-dropdown summary::-webkit-details-marker {
    display: none;
  }

  .nav-dropdown summary::after {
    position: absolute;
    right: 0;
    bottom: 0.2rem;
    left: 0;
    height: 2px;
    background: var(--color-primary);
    content: "";
    transform: scaleX(0);
    transform-origin: center;
    transition: transform var(--transition-fast);
  }

  .nav-dropdown summary:hover::after,
  .nav-dropdown summary[aria-current="page"]::after {
    transform: scaleX(1);
  }

  .nav-dropdown__panel {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 10;
    min-width: 14rem;
    margin-block-start: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
    padding: var(--space-2);
  }

  .nav-dropdown__panel a {
    display: block;
    padding: var(--space-2);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .nav-dropdown__panel a:hover {
    background: var(--color-surface-strong);
  }

  @media (max-width: 68rem) {
    .desktop-navigation {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    nav a::after,
    .nav-dropdown summary::after {
      transition: none;
    }
  }
</style>
