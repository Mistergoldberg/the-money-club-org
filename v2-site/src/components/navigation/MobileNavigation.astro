---
import {
  headerRoutes,
  isCurrentRoute,
  supportRoutes,
} from "../../data/navigation";
import Button from "../ui/Button.astro";

export interface Props {
  currentPath: string;
  menuId?: string;
}

const { currentPath, menuId = "site-mobile-menu" } = Astro.props;
const mobileRoutes = [
  ...headerRoutes.filter((route) => route.id !== "home"),
  ...supportRoutes,
];
---

<div class="mobile-navigation" data-mobile-navigation>
  <button
    class="mobile-navigation__trigger"
    type="button"
    aria-label="Open navigation menu"
    aria-expanded="false"
    aria-controls={menuId}
    data-menu-trigger
  >
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
  </button>

  <div
    class="mobile-navigation__overlay"
    id={menuId}
    role="dialog"
    aria-modal="true"
    aria-label="Navigation menu"
    data-menu-overlay
    data-state="closed"
    aria-hidden="true"
    inert
    hidden
  >
    <div class="mobile-navigation__panel" data-menu-panel>
      <div class="mobile-navigation__top">
        <a
          class="mobile-navigation__brand"
          href="/"
          aria-label="The Money Club home"
          aria-current={currentPath === "/" ? "page" : undefined}
        >
          <span>The Money Club</span><small>.Org</small>
        </a>
        <button
          class="mobile-navigation__close"
          type="button"
          aria-label="Close navigation menu"
          data-menu-close
        >
          <span aria-hidden="true">&times;</span>
        </button>
      </div>

      <nav aria-label="Mobile navigation">
        <ul role="list">
          {
            mobileRoutes.map((route) => (
              <li>
                <a
                  href={route.href}
                  aria-current={isCurrentRoute(currentPath, route.href) ? "page" : undefined}
                  data-menu-link
                >
                  {route.shortLabel ?? route.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <Button href="/parent-approval" variant="primary" size="large" fullWidth>
        Register for August
      </Button>
    </div>
  </div>
</div>

<script>
  const navigationRoots = document.querySelectorAll<HTMLElement>(
    "[data-mobile-navigation]",
  );

  navigationRoots.forEach((root) => {
    const trigger = root.querySelector<HTMLButtonElement>("[data-menu-trigger]");
    const overlay = root.querySelector<HTMLElement>("[data-menu-overlay]");
    const panel = root.querySelector<HTMLElement>("[data-menu-panel]");
    const closeButton = root.querySelector<HTMLButtonElement>("[data-menu-close]");
    const links = root.querySelectorAll<HTMLAnchorElement>("[data-menu-link]");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    if (!trigger || !overlay || !panel || !closeButton) {
      return;
    }

    const menuTrigger = trigger;
    const menuOverlay = overlay;
    const menuPanel = panel;
    const menuCloseButton = closeButton;

    const focusableSelector = [
      "a[href]",
      "button:not([disabled])",
      "input:not([disabled])",
      "select:not([disabled])",
      "textarea:not([disabled])",
      '[tabindex]:not([tabindex="-1"])',
    ].join(",");

    let isOpen = false;
    let closeTimer: number | undefined;
    let previousHtmlOverflow = "";
    let previousBodyPadding = "";

    function getFocusableElements(): HTMLElement[] {
      return Array.from(
        menuPanel.querySelectorAll<HTMLElement>(focusableSelector),
      ).filter((element) => !element.hasAttribute("hidden"));
    }

    function openMenu(): void {
      if (isOpen) {
        return;
      }

      window.clearTimeout(closeTimer);
      isOpen = true;
      menuOverlay.hidden = false;
      menuOverlay.inert = false;
      menuOverlay.setAttribute("aria-hidden", "false");
      document.body.dataset.menuOpen = "true";
      previousHtmlOverflow = document.documentElement.style.overflow;
      previousBodyPadding = document.body.style.paddingRight;
      const scrollbarWidth =
        window.innerWidth - document.documentElement.clientWidth;
      document.documentElement.style.overflow = "hidden";
      document.body.style.paddingRight =
        scrollbarWidth > 0 ? `${scrollbarWidth}px` : previousBodyPadding;
      menuTrigger.setAttribute("aria-expanded", "true");
      menuTrigger.setAttribute("aria-label", "Close navigation menu");

      window.requestAnimationFrame(() => {
        menuOverlay.dataset.state = "open";
        menuCloseButton.focus();
      });
    }

    function finishClose(): void {
      menuOverlay.hidden = true;
      delete document.body.dataset.menuOpen;
      document.documentElement.style.overflow = previousHtmlOverflow;
      document.body.style.paddingRight = previousBodyPadding;
    }

    function closeMenu(): void {
      if (!isOpen) {
        return;
      }

      isOpen = false;
      menuOverlay.dataset.state = "closed";
      menuOverlay.inert = true;
      menuOverlay.setAttribute("aria-hidden", "true");
      menuTrigger.setAttribute("aria-expanded", "false");
      menuTrigger.setAttribute("aria-label", "Open navigation menu");
      menuTrigger.focus();

      const delay = reducedMotion.matches ? 0 : 180;
      closeTimer = window.setTimeout(finishClose, delay);
    }

    function trapFocus(event: KeyboardEvent): void {
      if (!isOpen || event.key !== "Tab") {
        return;
      }

      const focusableElements = getFocusableElements();
      const first = focusableElements[0];
      const last = focusableElements[focusableElements.length - 1];

      if (!first || !last) {
        event.preventDefault();
        return;
      }

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    }

    menuTrigger.addEventListener("click", () => {
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    menuCloseButton.addEventListener("click", closeMenu);
    links.forEach((link) => link.addEventListener("click", closeMenu));

    menuOverlay.addEventListener("click", (event) => {
      if (event.target === menuOverlay) {
        closeMenu();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (!isOpen) {
        return;
      }

      if (event.key === "Escape") {
        event.preventDefault();
        closeMenu();
        return;
      }

      trapFocus(event);
    });

    const desktopQuery = window.matchMedia("(min-width: 68.01rem)");
    desktopQuery.addEventListener("change", (event) => {
      if (event.matches && isOpen) {
        closeMenu();
      }
    });
  });
</script>

<style>
  .mobile-navigation {
    display: none;
  }

  .mobile-navigation__trigger,
  .mobile-navigation__close {
    display: inline-grid;
    place-items: center;
    border: 0;
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
  }

  .mobile-navigation__trigger {
    width: 2.75rem;
    height: 2.75rem;
    gap: 0.3rem;
    align-content: center;
    border-radius: var(--radius-sm);
  }

  .mobile-navigation__trigger span {
    width: 1.65rem;
    height: 0.2rem;
    border-radius: var(--radius-pill);
    background: var(--color-secondary);
  }

  .mobile-navigation__overlay {
    position: fixed;
    z-index: 100;
    inset: 0;
    display: grid;
    justify-items: end;
    overflow: hidden;
    background: rgb(23 22 20 / 45%);
    opacity: 0;
    transition: opacity var(--transition-fast);
  }

  .mobile-navigation__overlay[hidden] {
    display: none;
  }

  .mobile-navigation__overlay[data-state="open"] {
    opacity: 1;
  }

  .mobile-navigation__panel {
    width: min(100%, 30rem);
    min-height: 100vh;
    min-height: 100dvh;
    max-height: 100vh;
    max-height: 100dvh;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--color-surface);
    padding: var(--space-3);
    box-shadow: -1rem 0 3rem rgb(23 22 20 / 18%);
    transform: translateX(100%);
    transition: transform var(--transition-fast);
  }

  .mobile-navigation__overlay[data-state="open"] .mobile-navigation__panel {
    transform: translateX(0);
  }

  .mobile-navigation__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block-end: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-navigation__brand {
    display: inline-flex;
    align-items: baseline;
    color: var(--color-primary);
    font-family: var(--font-display);
    font-size: 2rem;
    letter-spacing: var(--tracking-display);
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
  }

  .mobile-navigation__brand small {
    font-size: 0.55em;
  }

  .mobile-navigation__close {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-sm);
    font-size: 2.4rem;
    line-height: 1;
  }

  nav {
    padding-block: var(--space-3);
  }

  nav li + li {
    border-top: 1px solid var(--color-border);
  }

  nav a {
    display: flex;
    min-height: 3.5rem;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-2);
    font-size: var(--text-lead);
    font-weight: 700;
    text-decoration: none;
  }

  nav a[aria-current="page"] {
    color: var(--color-primary);
  }

  nav a[aria-current="page"]::after {
    color: var(--color-accent);
    content: "Current";
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
  }

  @media (max-width: 68rem) {
    .mobile-navigation {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-navigation__overlay,
    .mobile-navigation__panel {
      transition: none;
    }
  }
</style>
